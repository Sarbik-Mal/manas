{
	"compilerOptions": {
		"target": "ESNext",
		"module": "Preserve",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"types": ["bun"],
		"jsx": "react-jsx"
	},
	"include": ["packages/*/src", "packages/*/scripts", "evals"],
	// Sample projects the evals run on, not our code.
	"exclude": ["evals/fixtures"]
}
